---
interface Props {
  index: string;
  title: string;
  subtitle: string;
}

const { index, title, subtitle } = Astro.props;
---

<header class="mb-10">
  <p class="mb-3 text-sm text-electric">[{index}]</p>
  <div class="flex items-end gap-6">
    <h2 class="font-display text-5xl leading-display font-extrabold tracking-display lowercase md:text-7xl">
      {title}
    </h2>
    <span aria-hidden="true" class="mb-2 hidden h-4 flex-1 bg-ink md:block"></span>
  </div>
  <p class="mt-4 max-w-2xl text-sm text-ink/75">{subtitle}</p>
</header>
