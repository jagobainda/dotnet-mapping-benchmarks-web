---
import { ArrowUpRight } from 'lucide-astro';
import Button from './Button.astro';
import Glyph from './Glyph.astro';
import HeroBackdrop from './HeroBackdrop.astro';

interface Props {
  runAt?: string;
}

const { runAt } = Astro.props;

const formattedDate = runAt
  ? new Date(runAt).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    })
  : null;
const transmission = runAt ? new Date(runAt).toISOString().slice(11, 19) : null;

const nav = [
  { label: 'results', href: '#benchmarks' },
  { label: 'raw tables', href: '#tables' },
  { label: 'how it works', href: '#how-it-works' },
  { label: 'github', href: 'https://github.com/jagobainda/DotnetMappingBenchmarks', external: true },
];

let barX = 0;
const barcode = [3, 1, 2, 1, 4, 1, 1, 2, 3, 1, 2, 2, 1, 3, 1, 1, 4, 2, 1, 1, 2, 3].flatMap((w, i) => {
  const bar = { x: barX, width: w * 2 };
  barX += w * 2 + 1;
  return i % 2 ? [] : [bar];
});
---

<section class="relative flex min-h-svh flex-col overflow-hidden px-4 pt-6 pb-16 md:px-10">
  <HeroBackdrop />

  <nav aria-label="Sections" class="relative mx-auto w-full max-w-6xl">
    <ul class="flex flex-wrap justify-end gap-x-8 gap-y-1 pl-36 text-sm md:pl-0">
      {nav.map(({ label, href, external }, i) => (
        <li>
          <a
            href={href}
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener noreferrer' : undefined}
            class="group inline-flex gap-2 bg-ice/85 px-1 py-1"
          >
            <span class="text-electric">[0{i + 1}]</span>
            <span class="px-0.5 transition-colors duration-150 ease-hud group-hover:bg-ink group-hover:text-white">
              {label}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="relative m-auto grid w-full max-w-6xl gap-12 py-16 lg:grid-cols-[1fr_15rem]">
    <div class="lg:order-last lg:pt-6">
      <div class="w-fit border-[1.4px] border-electric bg-ice/80 p-3">
        <p class="flex flex-col items-start gap-1.5 text-sm text-white">
          <span class="bg-ink px-2 py-0.5">benchmarks running</span>
          <span class="ml-10 bg-ink px-2 py-0.5">every hour<span class="text-lime">_</span></span>
        </p>
        {transmission && <p class="mt-3 text-xs text-electric">TX {transmission} UTC · BDN</p>}
      </div>
      <div aria-hidden="true" class="mt-8 hidden items-center gap-3 text-sm lg:flex">
        <span>;B42</span>
        <svg class="h-4 fill-ink" viewBox={`0 0 ${barX} 16`} style={`width:${barX}px`}>
          {barcode.map(b => <rect x={b.x} width={b.width} height="16" />)}
        </svg>
      </div>
    </div>

    <div>
      <h1 class="font-display text-[clamp(2.75rem,10vw,6.75rem)] leading-display font-extrabold tracking-display lowercase">
        <span class="flex items-center gap-[0.15em]"><Glyph kind="star" class="size-[0.45em] shrink-0" />.NET Mapper</span>
        <span class="block pl-[12%]">
          <span data-text="Benchmarks" class="echo relative inline-block text-transparent">Benchmarks</span>
        </span>
      </h1>

      <div class="mt-8 max-w-xl border-[1.4px] border-electric bg-ice/85 p-4">
        <p class="text-sm leading-relaxed md:text-base">
          Real-time performance comparison of popular .NET object mapping libraries. Automated benchmarks with averaged
          results from the full history of the last 3 months.
        </p>

        {formattedDate && (
          <p class="mt-4 text-xs text-electric">
            LAST UPDATED · <time datetime={runAt} class="text-ink">{formattedDate}</time>
          </p>
        )}
      </div>

      <div class="mt-10 flex flex-wrap gap-4">
        <Button href="#benchmarks">View Results <span aria-hidden="true">▸</span></Button>
        <Button href="https://github.com/jagobainda/DotnetMappingBenchmarks" variant="secondary" external>
          GitHub Repo <ArrowUpRight size={18} />
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .echo {
    -webkit-text-stroke: 1.6px var(--color-ghost);
  }

  .echo::before,
  .echo::after {
    content: attr(data-text) / "";
    position: absolute;
    inset: 0;
  }

  .echo::before {
    -webkit-text-stroke: 1.6px var(--color-glitch);
    opacity: 0.35;
    transform: translate(-3px, 1px);
  }

  .echo::after {
    -webkit-text-stroke: 1.6px var(--color-electric);
    clip-path: inset(45% 0 40% 0);
    transform: translateX(16px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .echo::after {
      animation: glitch 300ms steps(3) 400ms both;
    }
  }

  @keyframes glitch {
    0% {
      clip-path: inset(10% 0 70% 0);
      transform: translateX(-18px);
    }
    50% {
      clip-path: inset(60% 0 20% 0);
      transform: translateX(22px);
    }
  }
</style>
