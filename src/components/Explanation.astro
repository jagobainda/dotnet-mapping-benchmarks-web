---
import { Timer, ChartColumn, RefreshCw, Target } from 'lucide-astro';
import Panel from './Panel.astro';
import SectionHeading from './SectionHeading.astro';

const features = [
  {
    Icon: Timer,
    title: 'Automated Execution',
    description: 'BenchmarkDotNet benchmarks run automatically every hour on a dedicated VPS.',
  },
  {
    Icon: ChartColumn,
    title: 'Averaged Results',
    description: 'Results shown are the average of the full history of the last 3 months, reducing noise and outliers.',
  },
  {
    Icon: RefreshCw,
    title: 'Auto-Updated Libraries',
    description: 'Library versions are updated automatically so benchmarks always reflect the latest releases.',
  },
  {
    Icon: Target,
    title: 'Multiple Scenarios',
    description: 'Each library is tested across flat mapping, nested objects, collections, and name differences.',
  },
];
---

<section id="how-it-works" class="py-20 px-4 md:px-10">
  <div class="max-w-6xl mx-auto">
    <SectionHeading
      index="02"
      title="How It Works"
      subtitle="A transparent and reproducible benchmarking pipeline for .NET object mappers"
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {features.map(({ Icon, title, description }, i) => (
        <Panel tag={title} meta={`[0${i + 1}]`}>
          <div class="flex gap-4">
            <Icon size={20} class="shrink-0 text-electric" stroke-width={1.6} stroke-linecap="butt" stroke-linejoin="miter" />
            <p class="text-sm leading-relaxed">{description}</p>
          </div>
        </Panel>
      ))}
    </div>
  </div>
</section>
