---
import type { BenchmarkData } from '../types';
import Panel from './Panel.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
  data: BenchmarkData;
}

const { data } = Astro.props;
const caseNames = data.libraries[0].cases.map(c => c.name);
const libraryNames = data.libraries.map(l => l.name);

const HIDDEN_BY_DEFAULT = new Set(['AgileMapper']);
const isActive = (name: string) => !HIDDEN_BY_DEFAULT.has(name);

const caseDescriptions: Record<string, string> = {
  SimpleFlat:     'Flat object with primitive properties',
  NestedObject:   'Object containing nested child objects',
  Collection:     'Object with a collection of 100 items',
  NameDifference: 'Source and target have different property names',
};
---

<section id="benchmarks" class="px-4 py-20 md:px-10">
  <div class="max-w-6xl mx-auto">
    <SectionHeading
      index="01"
      title="Benchmark Results"
      subtitle="Average of last 3 months · Mean execution time in microseconds (μs) · Lower is better"
    />

    <Panel tag="Libraries" meta={`${libraryNames.length} LIBS · TOGGLE TO FILTER`} class="mb-10">
      <div class="grid gap-x-6 gap-y-3 sm:grid-cols-2 lg:grid-cols-4">
        {libraryNames.map(name => (
          <label class="group flex items-center gap-2.5 cursor-pointer select-none">
            <input type="checkbox" class="sr-only" data-library={name} checked={isActive(name) || undefined} />
            <span class="relative block w-10 h-5 border-[1.4px] border-electric transition-colors duration-150 ease-hud group-has-checked:bg-electric group-has-focus-visible:outline-2 group-has-focus-visible:outline-offset-3 group-has-focus-visible:outline-electric">
              <span class="absolute top-0.5 left-0.5 size-3.5 bg-electric transition-transform duration-150 ease-hud group-has-checked:translate-x-4.75 group-has-checked:bg-white"></span>
            </span>
            <span class="text-sm whitespace-nowrap text-ink/60 group-has-checked:text-ink transition-colors duration-150">{name}</span>
          </label>
        ))}
      </div>
    </Panel>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {caseNames.map((caseName, i) => (
        <Panel tag={caseName} meta={`CASE 0${i + 1} · μs`}>
          <p class="text-sm text-ink/75 mb-4">{caseDescriptions[caseName] ?? ''}</p>
          <div class="h-56">
            <canvas id={`chart-${i}`}></canvas>
          </div>
        </Panel>
      ))}
    </div>

    <div id="tables" class="scroll-mt-8">
      <Panel tag="Mean Execution Time" meta="μs / op" class="mt-12">
        <p class="text-sm text-ink/75 mb-4">Microseconds (μs) per operation · lower is better · average of last 3 months</p>
        <div class="overflow-x-auto">
          <table class="w-full text-sm" aria-label="Mean execution time in microseconds per library and scenario">
            <thead>
              <tr class="border-b-[1.4px] border-electric text-electric text-xs uppercase tracking-wider">
                <th class="text-left py-2.5 px-3 font-semibold">Library</th>
                <th class="text-left py-2.5 px-3 font-semibold">Version</th>
                {caseNames.map(cn => (
                  <th class="text-right py-2.5 px-3 font-semibold">{cn} (μs)</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {data.libraries.map(lib => (
                <tr
                  class="border-b border-dashed border-electric/30 hover:bg-electric-pale/60 transition-all duration-150"
                  data-lib-row={lib.name}
                  style={HIDDEN_BY_DEFAULT.has(lib.name) ? 'opacity:0.2' : ''}
                >
                  <td class="py-2.5 px-3 font-extrabold">{lib.name}</td>
                  <td class="py-2.5 px-3 text-ink/60 text-xs">{lib.version}</td>
                  {lib.cases.map(c => (
                    <td class="text-right py-2.5 px-3 text-xs">
                      {c.mean_us} μs
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Panel>

      <Panel tag="Memory Allocation" meta="B / op" class="mt-8">
        <p class="text-sm text-ink/75 mb-4">Bytes allocated per operation</p>
        <div class="overflow-x-auto">
          <table class="w-full text-sm" aria-label="Memory allocation in bytes per library and scenario">
            <thead>
              <tr class="border-b-[1.4px] border-electric text-electric text-xs uppercase tracking-wider">
                <th class="text-left py-2.5 px-3 font-semibold">Library</th>
                <th class="text-left py-2.5 px-3 font-semibold">Version</th>
                {caseNames.map(cn => (
                  <th class="text-right py-2.5 px-3 font-semibold">{cn}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {data.libraries.map(lib => (
                <tr
                  class="border-b border-dashed border-electric/30 hover:bg-electric-pale/60 transition-all duration-150"
                  data-lib-row={lib.name}
                  style={HIDDEN_BY_DEFAULT.has(lib.name) ? 'opacity:0.2' : ''}
                >
                  <td class="py-2.5 px-3 font-extrabold">{lib.name}</td>
                  <td class="py-2.5 px-3 text-ink/60 text-xs">{lib.version}</td>
                  {lib.cases.map(c => (
                    <td class="text-right py-2.5 px-3 text-xs">
                      {c.alloc_bytes.toLocaleString()} B
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Panel>
    </div>
  </div>
</section>

<div id="benchmark-data" class="hidden">{JSON.stringify(data)}</div>

<script>
  import Chart from 'chart.js/auto';

  const dataEl = document.getElementById('benchmark-data');
  if (!dataEl?.textContent) throw new Error('Missing benchmark data');
  const benchData = JSON.parse(dataEl.textContent);

  const libraryNames: string[] = benchData.libraries.map((l: any) => l.name);
  const caseNames: string[] = benchData.libraries[0].cases.map((c: any) => c.name);

  const rootStyle = getComputedStyle(document.documentElement);
  const token = (name: string) => rootStyle.getPropertyValue(`--${name}`).trim();
  const ELECTRIC = token('color-electric');
  const INK = token('color-ink');
  const DARK = matchMedia('(prefers-color-scheme: dark)').matches;

  Chart.defaults.font.family = token('font-mono');
  await document.fonts.ready;

  const HIDDEN_BY_DEFAULT = new Set(['AgileMapper']);
  const visible = new Set<string>(libraryNames.filter(n => !HIDDEN_BY_DEFAULT.has(n)));
  const charts = new Map<number, Chart>();

  function getFilteredEntries(caseName: string) {
    return benchData.libraries
      .filter((lib: any) => visible.has(lib.name))
      .map((lib: any) => {
        const c = lib.cases.find((c: any) => c.name === caseName);
        return { label: lib.name, value: c?.mean_us ?? 0 };
      })
      .sort((a: any, b: any) => a.value - b.value);
  }

  function refreshChart(index: number, caseName: string) {
    const chart = charts.get(index);
    if (!chart) return;
    const entries = getFilteredEntries(caseName);
    chart.data.labels = entries.map((e: any) => e.label);
    chart.data.datasets[0].data = entries.map((e: any) => e.value);
    chart.update();
  }

  caseNames.forEach((caseName, i) => {
    const canvas = document.getElementById(`chart-${i}`) as HTMLCanvasElement | null;
    if (!canvas) return;
    const entries = getFilteredEntries(caseName);

    charts.set(i, new Chart(canvas, {
      type: 'bar',
      data: {
        labels: entries.map((e: any) => e.label),
        datasets: [{
          data: entries.map((e: any) => e.value),
          backgroundColor: ELECTRIC,
          hoverBackgroundColor: INK,
          borderWidth: 0,
          barThickness: 18,
        }],
      },
      options: {
        indexAxis: 'y',
        responsive: true,
        maintainAspectRatio: false,
        animation: { duration: 200 },
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: '#000',
            titleColor: '#fff',
            bodyColor: token('color-lime'),
            borderColor: token('color-lime'),
            borderWidth: 1,
            cornerRadius: 0,
            displayColors: false,
            padding: 10,
            callbacks: { label: (ctx) => `${ctx.parsed.x} μs` },
          },
        },
        scales: {
          x: {
            title: { display: true, text: 'μs (lower is better)', color: ELECTRIC, font: { size: 11 } },
            ticks: { color: DARK ? INK : ELECTRIC, font: { size: 11 } },
            grid: { color: `${ELECTRIC}1A` },
            border: { color: ELECTRIC },
          },
          y: {
            ticks: { color: INK, font: { size: 12 } },
            grid: { display: false },
            border: { display: false },
          },
        },
      },
    }));
  });

  document.querySelectorAll<HTMLInputElement>('input[data-library]').forEach(input => {
    const lib = input.getAttribute('data-library')!;

    input.addEventListener('change', () => {
      input.checked ? visible.add(lib) : visible.delete(lib);

      document.querySelectorAll<HTMLElement>(`[data-lib-row="${lib}"]`).forEach(row => {
        row.style.opacity = input.checked ? '1' : '0.2';
      });

      caseNames.forEach((caseName, i) => refreshChart(i, caseName));
    });
  });
</script>
