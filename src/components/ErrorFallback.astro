---
import { TriangleAlert } from 'lucide-astro';
import Button from './Button.astro';
import Panel from './Panel.astro';

interface Props {
  message?: string | null;
}

const { message } = Astro.props;
---

<section class="py-12 px-4">
  <Panel tag="Data Unavailable" meta="ERR · CDN" headingLevel={2} class="max-w-md mx-auto">
    <div class="flex gap-4 mb-6">
      <TriangleAlert size={20} class="shrink-0 text-electric" stroke-width={1.6} stroke-linecap="butt" stroke-linejoin="miter" />
      <p class="text-sm">
        {message || 'Benchmark data could not be loaded. The server might be temporarily unavailable.'}
      </p>
    </div>
    <Button href="/" variant="secondary">Try Again</Button>
  </Panel>
</section>
